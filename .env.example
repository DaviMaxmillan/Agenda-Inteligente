# =============================================================
# Agenda Inteligente — Variáveis de Ambiente
# =============================================================
# Copie este arquivo para .env e preencha os valores.
# As variáveis marcadas com (*) são OBRIGATÓRIAS para funcionar.

# =============================================================
# RAILWAY (Backend + Banco de Dados)
# =============================================================

# (*) URL de conexão com o PostgreSQL
# O Railway gera automaticamente quando você adicionar um serviço Postgres.
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@host:port/dbname

# (*) Porta em que o servidor Express irá escutar
PORT=5000

# (*) Ambiente de execução
NODE_ENV=production

# (*) URL do frontend no Vercel (sem barra no final)
# Usada para o redirect após o OAuth do Google Calendar
FRONTEND_URL=https://agenda-inteligente-agenda.vercel.app

# =============================================================
# GOOGLE CALENDAR OAUTH
# Obtenha em: https://console.cloud.google.com
# Veja o guia: GOOGLE_SETUP.md
# =============================================================

# (*) ID do cliente OAuth 2.0
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# (*) Segredo do cliente OAuth 2.0
GOOGLE_CLIENT_SECRET=seu-client-secret

# (*) URI de callback OAuth — deve ser registrada EXATAMENTE assim no Google Console
# Aponta para o backend no Railway
GOOGLE_REDIRECT_URI=https://agenda-inteligente-production-3be4.up.railway.app/api/google-calendar/callback

# =============================================================
# NOTIFICAÇÕES WHATSAPP (opcional)
# =============================================================

# CallMeBot (gratuito) — configurado via painel /settings
# Twilio (pago) — configurado via painel /settings
# As credenciais são salvas no banco de dados via UI, não aqui.
